# 監聽位址與埠
PORT=2567
HOST=0.0.0.0
# 地圖資料目錄（map-build 的輸出），預設為 repo 的 assets/maps
MAPS_DIR=/app/maps
# 預設地圖（找不到時退回內建的灰盒地圖）
DEFAULT_MAP=forest-valley
# 每場預設以 bot 補到幾人（0 = 不放 bot；客戶端建立房間時可以指定）
BOT_FILL=8
# 允許連線的網站來源（逗號分隔）。正式環境務必設定。
ALLOWED_ORIGINS=https://frontline.example.com
# 斷線保留位置的秒數
RECONNECT_SECONDS=30
# 每個 IP 每 10 秒最多加入幾次
JOIN_RATE_LIMIT=12
# 對戰結果紀錄檔（JSONL）
RESULTS_LOG=/app/logs/match-results.jsonl
# debug、info、warn、error
LOG_LEVEL=info
# 開發與自動化測試用指令（傳送玩家等）。正式環境必須是 0 或不設定。
DEV_COMMANDS=0
